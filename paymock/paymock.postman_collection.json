{
  "info": {
    "name": "PayMock Gateway API Collection",
    "description": "Merchant API ของ PayMock + Concert Backend\n\nPOST /v1/payments ต้องส่ง payment_id ทุกครั้ง; ตัวอย่าง merchant ทั่วไปใช้เลขล้วน เช่น 12 และตั้ง Idempotency-Key เป็น 12. Concert backend ใช้ booking-{id}-attempt-{n} เพื่อแยกการลองจ่ายแต่ละครั้งใน booking เดิม.\nResponse: id = txn_… คือ provider transaction ID ตัวเดียวสำหรับ GET / cancel / QR / concert; payment_id คือรหัสที่ merchant ส่งมา\n\nChaos / Webhook ผิดปกติตั้งที่ PayMock Admin (ชั้น 1 chaos_mode, ชั้น 2 webhook_mode)\n\nเวลา: created_at = สร้างรายการ | paid_at = จ่ายสำเร็จ (เฉพาะ COMPLETED) | ไม่มี completed_at",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081", "type": "string" },
    { "key": "apiKey", "value": "pm_test_key_concert_system_2024", "type": "string" },
    { "key": "bookingCode", "value": "101", "type": "string" },
    { "key": "bookingId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "txn_test", "type": "string" },
    { "key": "promptPayId", "value": "txn_test", "type": "string" },
    { "key": "concertUrl", "value": "http://localhost:5000", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{apiKey}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every direct gateway request uses one stable key per payment attempt.",
          "if (pm.request.method === 'POST' && /\\/v1\\/payments$/.test(pm.request.url.toString()) && pm.request.body && pm.request.body.raw) {",
          "  var body = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
          "  if (body.payment_id) pm.request.headers.upsert({ key: 'Idempotency-Key', value: String(body.payment_id) });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function saveGatewayIds(jsonData) {",
          "  if (!jsonData || !jsonData.id) return;",
          "  pm.collectionVariables.set('paymentId', jsonData.id);",
          "}",
          "function assertMerchantPaymentId(jsonData) {",
          "  if (!jsonData || jsonData.error) return;",
          "  if (jsonData.payment_id === undefined) return;",
          "  pm.test('payment_id is not null', function () {",
          "    pm.expect(jsonData.payment_id).to.not.equal(null);",
          "    pm.expect(String(jsonData.payment_id).length).to.be.above(0);",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check (Docker /up)",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/up", "host": ["{{baseUrl}}"], "path": ["up"] }
          }
        }
      ]
    },
    {
      "name": "1. Standard Payment Flow",
      "item": [
        {
          "name": "Create Card Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set('paymentId', jsonData.id); }",
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('payment_id is merchant id, not null', function () {",
                  "  pm.expect(jsonData.payment_id).to.eql('12');",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "});",
                  "pm.test('id is gateway txn', function () {",
                  "  pm.expect(jsonData.id).to.be.a('string').and.match(/^txn_/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "12" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 1500.00,\n  \"currency\": \"THB\",\n  \"method\": \"card\",\n  \"card_number\": \"4242424242424242\",\n  \"exp_month\": \"12\",\n  \"exp_year\": \"28\",\n  \"cvc\": \"123\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"expires_in\": 600\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Create PromptPay Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "  pm.collectionVariables.set('promptPayId', jsonData.id);",
                  "  pm.collectionVariables.set('paymentId', jsonData.id);",
                  "}",
                  "pm.test('status 201 PENDING', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(jsonData.status).to.eql('PENDING');",
                  "});",
                  "pm.test('payment_id is not null', function () {",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "  pm.expect(jsonData.payment_id).to.eql('202');",
                  "});",
                  "pm.test('PromptPay URLs present', function () {",
                  "  pm.expect(jsonData.qrcode_url).to.be.a('string').and.include('/qr.svg');",
                  "  pm.expect(jsonData.bank_simulator_url).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "PP-{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"202\",\n  \"amount\": 2200.00,\n  \"currency\": \"THB\",\n  \"method\": \"promptpay\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"expires_in\": 600\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Idempotency Test (Send duplicate Idempotency-Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('same gateway id as first create', function () {",
                  "  pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('paymentId'));",
                  "});",
                  "pm.test('payment_id still present', function () {",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{bookingCode}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 1500.00,\n  \"currency\": \"THB\",\n  \"method\": \"card\",\n  \"card_number\": \"4242424242424242\",\n  \"exp_month\": \"12\",\n  \"exp_year\": \"28\",\n  \"cvc\": \"123\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Get Payment Status (Polling / Reconcile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('payment_id is not null', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "  pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('paymentId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["v1", "payments", "{{paymentId}}"] },
            "description": "path ใช้ response.id (txn_…) ไม่ใช่ payment_id ของร้านค้า"
          }
        },
        {
          "name": "Cancel Payment (Before Paid)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/v1/payments/{{paymentId}}/cancel", "host": ["{{baseUrl}}"], "path": ["v1", "payments", "{{paymentId}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "2. Card Payment – Magic Numbers (POST /v1/payments)",
      "description": "ส่ง payment_id + card_number ใน body → ประมวลผลทันทีใน request เดียว. แต่ละคำขอใช้ Idempotency-Key ไม่ซ้ำกัน",
