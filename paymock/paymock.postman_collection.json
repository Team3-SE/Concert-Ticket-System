    {
      "name": "5. Concert Backend — ใช้ payment_id (บัตร + PromptPay)",
      "description": "สร้าง booking ครั้งแรกได้ payment attempt #1. หาก FAILED/EXPIRED ให้เรียก retry-payment โดยส่ง booking_id เดิม; backend จะสร้าง payment_id และ Idempotency-Key ใหม่เป็น booking-{id}-attempt-{n}. ทุก call หลังสร้างใช้ response.payment_id (txn_…) เป็น provider transaction ID.",
      "item": [
        {
          "name": "POST create-booking — attempt 1",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "var j = pm.response.json();",
              "pm.test('booking created with attempt 1', function () { pm.expect(j.ok).to.eql(true); pm.expect(j.attempt_number).to.eql(1); });",
              "if (j.ok) { pm.collectionVariables.set('bookingId', String(j.booking_id)); pm.collectionVariables.set('paymentId', j.payment_id); }"
            ] }
          }],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"seat\": \"VIP-A1\",\n  \"amount\": 3500.00,\n  \"method\": \"card\",\n  \"card_number\": \"4000000000000002\",\n  \"exp_month\": \"12\",\n  \"exp_year\": \"28\",\n  \"cvc\": \"123\"\n}" },
            "url": { "raw": "{{concertUrl}}/api/create-booking", "host": ["{{concertUrl}}"], "path": ["api", "create-booking"] }
          }
        },
        {
          "name": "POST retry-payment — attempt ใหม่ใน booking เดิม",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "var j = pm.response.json();",
              "pm.test('same booking, next payment attempt', function () { pm.expect(j.ok).to.eql(true); pm.expect(String(j.booking_id)).to.eql(pm.collectionVariables.get('bookingId')); pm.expect(j.attempt_number).to.eql(2); });",
              "if (j.ok) pm.collectionVariables.set('paymentId', j.payment_id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"booking_id\": \"{{bookingId}}\",\n  \"method\": \"card\",\n  \"card_number\": \"4242424242424242\",\n  \"exp_month\": \"12\",\n  \"exp_year\": \"28\",\n  \"cvc\": \"123\"\n}" },
            "url": { "raw": "{{concertUrl}}/api/retry-payment", "host": ["{{concertUrl}}"], "path": ["api", "retry-payment"] }
          }
