{
  "info": {
    "name": "PayMock Gateway API Collection",
    "description": "Merchant API ของ PayMock + Concert Backend\n\nPOST /v1/payments ต้องส่ง payment_id ทุกครั้ง; ตัวอย่าง merchant ทั่วไปใช้เลขล้วน เช่น 12 และตั้ง Idempotency-Key เป็น 12. Concert backend สร้าง Concert payment ใหม่ใต้ booking เดิมเมื่อ FAILED/EXPIRED และใช้เลข Concert payment นั้นเป็น payment_id.\nResponse: id = txn_… คือ provider transaction ID ตัวเดียวสำหรับ GET / cancel / QR / concert; payment_id คือรหัสที่ merchant ส่งมา\n\nChaos / Webhook ผิดปกติตั้งที่ PayMock Admin (ชั้น 1 chaos_mode, ชั้น 2 webhook_mode)\n\nเวลา: created_at = สร้างรายการ | paid_at = จ่ายสำเร็จ (เฉพาะ COMPLETED) | ไม่มี completed_at",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081", "type": "string" },
    { "key": "apiKey", "value": "pm_test_key_concert_system_2024", "type": "string" },
    { "key": "bookingCode", "value": "101", "type": "string" },
    { "key": "bookingId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "txn_test", "type": "string" },
    { "key": "promptPayId", "value": "txn_test", "type": "string" },
    { "key": "concertUrl", "value": "http://localhost:5000", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{apiKey}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every direct gateway request uses one stable key for that payment.",
          "if (pm.request.method === 'POST' && /\\/v1\\/payments$/.test(pm.request.url.toString()) && pm.request.body && pm.request.body.raw) {",
          "  var body = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
          "  if (body.payment_id) pm.request.headers.upsert({ key: 'Idempotency-Key', value: String(body.payment_id) });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function saveGatewayIds(jsonData) {",
          "  if (!jsonData || !jsonData.id) return;",
          "  pm.collectionVariables.set('paymentId', jsonData.id);",
          "}",
          "function assertMerchantPaymentId(jsonData) {",
          "  if (!jsonData || jsonData.error) return;",
          "  if (jsonData.payment_id === undefined) return;",
          "  pm.test('payment_id is not null', function () {",
          "    pm.expect(jsonData.payment_id).to.not.equal(null);",
          "    pm.expect(String(jsonData.payment_id).length).to.be.above(0);",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check (Docker /up)",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/up", "host": ["{{baseUrl}}"], "path": ["up"] }
          }
        }
      ]
    },
    {
      "name": "1. Standard Payment Flow",
      "item": [
        {
          "name": "Create Card Payment (Hosted Checkout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set('paymentId', jsonData.id); }",
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('payment_id is merchant id, not null', function () {",
                  "  pm.expect(jsonData.payment_id).to.eql('12');",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "});",
                  "pm.test('id is gateway txn', function () {",
                  "  pm.expect(jsonData.id).to.be.a('string').and.match(/^txn_/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "12" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 1500.00,\n  \"currency\": \"THB\",\n  \"method\": \"card\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"return_url\": \"{{concertUrl}}/booking/123\",\n  \"expires_in\": 600\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Create PromptPay Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "  pm.collectionVariables.set('promptPayId', jsonData.id);",
                  "  pm.collectionVariables.set('paymentId', jsonData.id);",
                  "}",
                  "pm.test('status 201 PENDING', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(jsonData.status).to.eql('PENDING');",
                  "});",
                  "pm.test('payment_id is not null', function () {",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "  pm.expect(jsonData.payment_id).to.eql('202');",
                  "});",
                  "pm.test('PromptPay URLs present', function () {",
                  "  pm.expect(jsonData.qrcode_url).to.be.a('string').and.include('/qr.svg');",
                  "  pm.expect(jsonData.bank_simulator_url).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "PP-{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"202\",\n  \"amount\": 2200.00,\n  \"currency\": \"THB\",\n  \"method\": \"promptpay\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"expires_in\": 600\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Idempotency Test (Send duplicate Idempotency-Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('same gateway id as first create', function () {",
                  "  pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('paymentId'));",
                  "});",
                  "pm.test('payment_id still present', function () {",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{bookingCode}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 1500.00,\n  \"currency\": \"THB\",\n  \"method\": \"card\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"return_url\": \"{{concertUrl}}/booking/123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Get Payment Status (Polling / Reconcile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('payment_id is not null', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "  pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('paymentId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["v1", "payments", "{{paymentId}}"] },
            "description": "path ใช้ response.id (txn_…) ไม่ใช่ payment_id ของร้านค้า"
          }
        },
        {
          "name": "Cancel Payment (Before Paid)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/v1/payments/{{paymentId}}/cancel", "host": ["{{baseUrl}}"], "path": ["v1", "payments", "{{paymentId}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "2. Hosted Card Checkout Redirect",
      "description": "สร้าง Card payment ให้เป็น PENDING ก่อนด้วย POST /v1/payments แล้วเปิด checkout_url ในเบราว์เซอร์ ผู้ใช้กรอกบัตรบน Hosted Checkout และ form จะ POST /payments/{publicId} เพื่อชำระ payment เดิม ก่อน redirect ไป return_url พร้อม ?payment_id={publicId}",
      "item": [
        {
          "name": "Step 1 – Create Card Payment (PENDING + checkout_url)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set('hostedCardId', jsonData.id); }",
                  "pm.test('PENDING and hosted checkout URL returned', function () {",
                  "  pm.expect(jsonData.status).to.eql('PENDING');",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "  pm.expect(jsonData.checkout_url).to.include('/checkout/');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "CARD_PENDING_{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"HOSTED_CARD_{{$timestamp}}\",\n  \"amount\": 1500.00,\n  \"currency\": \"THB\",\n  \"method\": \"card\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"return_url\": \"{{concertUrl}}/booking/123\",\n  \"expires_in\": 600\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] },
            "description": "คัดลอก checkout_url ไปเปิดใน browser หรือรัน request ถัดไปเพื่อจำลองการ submit form จาก hosted checkout"
          }
        },
        {
          "name": "Step 2 – Submit card to POST /payments/{publicId}",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Redirects to the merchant return URL', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([302, 303]);",
                  "  pm.expect(pm.response.headers.get('Location')).to.include('payment_id=');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "card_number", "value": "4242 4242 4242 4242" },
                { "key": "expiry", "value": "12/28" },
                { "key": "cvc", "value": "123" },
                { "key": "cardholder", "value": "SUCCESS USER" },
                { "key": "redirect_to_return", "value": "1" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/payments/{{hostedCardId}}", "host": ["{{baseUrl}}"], "path": ["payments", "{{hostedCardId}}"] },
            "description": "route ของ Hosted Checkout ที่ใช้ settle payment เดิม; ส่ง form fields จากหน้า checkout เท่านั้น ไม่ส่ง API key"
          }
        },
        {
          "name": "Deprecated native-card case — use Hosted Card Flow above",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Card creation is PENDING until Hosted Checkout', function () {",
                  "  pm.expect(jsonData.status).to.eql('PENDING');",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "CARD_DECLINE_{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 1500.00,\n  \"method\": \"card\",\n  \"return_url\": \"{{concertUrl}}/booking/123\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Card: create PENDING for Hosted Checkout (funds case)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('payment_id is not null', function () { pm.expect(jsonData.payment_id).to.not.equal(null); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "CARD_NSF_{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 1500.00,\n  \"method\": \"card\",\n  \"return_url\": \"{{concertUrl}}/booking/123\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Card: create PENDING for Hosted Checkout (expiry case)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "CARD_EXP_{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 1500.00,\n  \"method\": \"card\",\n  \"return_url\": \"{{concertUrl}}/booking/123\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Card: create PENDING for Hosted Checkout (CVC case)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "CARD_CVC_{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 1500.00,\n  \"method\": \"card\",\n  \"return_url\": \"{{concertUrl}}/booking/123\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Card: create PENDING for Hosted Checkout (processing case)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "CARD_PROC_{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 1500.00,\n  \"method\": \"card\",\n  \"return_url\": \"{{concertUrl}}/booking/123\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Card: create PENDING for Hosted Checkout (fraud case)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "CARD_FRAUD_{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 1500.00,\n  \"method\": \"card\",\n  \"return_url\": \"{{concertUrl}}/booking/123\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Card: create PENDING for Hosted Checkout (delayed webhook case)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "CARD_DELAYWH_{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 1500.00,\n  \"method\": \"card\",\n  \"return_url\": \"{{concertUrl}}/booking/123\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] },
            "description": "จ่ายสำเร็จทันที; ความผิดปกติของ webhook ตั้งจาก PayMock Admin Webhook Mode เท่านั้น"
          }
        }
      ]
    },
    {
      "name": "3. PromptPay – All Cases",
      "description": "สร้างด้วย POST /v1/payments (method=promptpay, body.payment_id) → ได้ PENDING + payment_id แล้วจบด้วย simulate, bank-simulate หรือ cancel โดยใช้ response.id",
      "item": [
        {
          "name": "PromptPay: Create (PENDING + QR URLs)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "  pm.collectionVariables.set('promptPayId', jsonData.id);",
                  "  pm.collectionVariables.set('paymentId', jsonData.id);",
                  "}",
                  "pm.test('PENDING PromptPay has payment_id', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(jsonData.status).to.eql('PENDING');",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "  pm.expect(jsonData.paid_at).to.equal(null);",
                  "  pm.expect(jsonData.qrcode_url).to.include('/qr.svg');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "PP_CREATE_{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 2200.00,\n  \"currency\": \"THB\",\n  \"method\": \"promptpay\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"expires_in\": 600\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] },
            "description": "คาดหวัง: status=PENDING, payment_id ไม่เป็น null, paid_at=null, qrcode_url, bank_simulator_url"
          }
        },
        {
          "name": "PromptPay: GET QR SVG (no auth)",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/v1/payments/{{promptPayId}}/qr.svg", "host": ["{{baseUrl}}"], "path": ["v1", "payments", "{{promptPayId}}", "qr.svg"] }
          }
        },
        {
          "name": "PromptPay: Simulate COMPLETED (POST /checkout/.../simulate)",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/checkout/{{promptPayId}}/simulate", "host": ["{{baseUrl}}"], "path": ["checkout", "{{promptPayId}}", "simulate"] },
            "description": "รันหลัง Create — ใช้ {{promptPayId}} = response.id | ตั้ง paid_at=now(), ยิง webhook payment.completed"
          }
        },
        {
          "name": "PromptPay: Create then Simulate FAILED (payment_declined)",
          "item": [
            {
              "name": "Step 1 – Create PENDING",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var j = pm.response.json();",
                      "if (j.id) pm.collectionVariables.set('promptPayFailId', j.id);",
                      "pm.test('payment_id is not null', function () {",
                      "  pm.expect(j.payment_id).to.not.equal(null);",
                      "  pm.expect(j.status).to.eql('PENDING');",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Idempotency-Key", "value": "PP_FAIL_{{$timestamp}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"payment_id\": \"12\",\n  \"amount\": 900.00,\n  \"method\": \"promptpay\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"expires_in\": 600\n}"
                },
                "url": { "raw": "{{baseUrl}}/v1/payments", "host": ["{{baseUrl}}"], "path": ["v1", "payments"] }
              }
            },
            {
              "name": "Step 2 – Simulate FAILED",
              "request": {
                "method": "POST",
                "auth": { "type": "noauth" },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"FAILED\",\n  \"failure_code\": \"payment_declined\"\n}"
                },
