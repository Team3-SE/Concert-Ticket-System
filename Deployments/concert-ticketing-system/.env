# ============================================================
# Concert Ticketing System — Environment Variables
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_NAME="Concert Ticketing System"
APP_ENV=local
APP_KEY=base64:NPm+yB7EBVc9dru1741g12UsInb8Sd4gjGS/B3oAllg=
APP_DEBUG=true
APP_URL=http://localhost:8080

# ─── Timezone / Locale ───────────────────────────────────────
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=th
APP_FALLBACK_LOCALE=en

# ─── Database (MySQL) ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=concert_db
DB_USERNAME=concert_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

# ─── Cache / Session / Queue ─────────────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ─── NGINX Port (host machine port) ──────────────────────────
NGINX_PORT=8080

# ─── Mail (for notifications) ────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@concert.local"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Cloudflare (production only) ────────────────────────────
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# ─── Seat Lock TTL (seconds) ──────────────────────────────────
SEAT_LOCK_TTL=600
