{
  "info": {
    "name": "PayMock Gateway API Collection",
    "description": "PayMock merchant and Concert backend API collection. POST /v1/payments requires body.payment_id. Idempotency key selection: if Idempotency-Key header is present, it is used; otherwise body.payment_id is used. No idempotency_key JSON body field is read. Keep the selected key unchanged when retrying an attempt. PayMock payment routes use id in the path; POST /v1/payments uses body.payment_id and booking_ref. Concert demo requests use query/body.payment_id. PromptPay responses include qrcode_url and bank_simulator_url but omit checkout_url. Card responses include checkout_url but omit PromptPay URLs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "pm_test_key_concert_system_2024",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymockId",
      "value": "txn_test",
      "type": "string",
      "description": "Use in the path parameter named id."
    },
    {
      "key": "promptPayId",
      "value": "txn_test",
      "type": "string",
      "description": "Use in PromptPay path parameters named id."
    },
    {
      "key": "concertUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "cardPaymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "hostedCardId",
      "value": "",
      "type": "string"
    },
    {
      "key": "csrfToken",
      "value": "",
      "type": "string",
      "description": "CSRF token extracted from the hosted checkout page before submitting the card form."
    },
    {
      "key": "promptPayFailId",
      "value": "",
      "type": "string"
    },
    {
      "key": "promptPayBankId",
      "value": "",
      "type": "string"
    },
    {
      "key": "promptPayCancelId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cardMerchantPaymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cardIdempotencyKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "bodyOnlyMerchantPaymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bodyOnlyPaymockId",
      "value": "",
      "type": "string"
    },
    {
      "key": "concertPaymentId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check (Docker /up)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "up"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Standard Payment Flow",
      "item": [
        {
          "name": "Create Card Payment (Hosted Checkout)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var attemptId = 'CARD_' + pm.variables.replaceIn('{{$guid}}');",
                  "var idempotencyKey = 'IDEM_' + pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('cardMerchantPaymentId', attemptId);",
                  "pm.collectionVariables.set('cardIdempotencyKey', idempotencyKey);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set('paymockId', jsonData.id); }",
                  "if (jsonData.id) { pm.collectionVariables.set('cardPaymentId', jsonData.id); }",
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('payment_id is merchant id, not null', function () {",
                  "  pm.expect(jsonData.payment_id).to.eql(pm.collectionVariables.get('cardMerchantPaymentId'));",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "});",
                  "pm.test('id is gateway txn', function () {",
                  "  pm.expect(jsonData.id).to.be.a('string').and.match(/^txn_/);",
                  "});",
                  "pm.test('return_url is returned', function () {",
                  "  pm.expect(jsonData.return_url).to.be.a('string').and.include('/booking/TK-260101-ABCDE');",
                  "});",
                  "pm.test('Card has checkout_url only', function () {",
                  "  pm.expect(jsonData.checkout_url).to.be.a('string').and.include('/checkout/');",
                  "  pm.expect(jsonData).to.not.have.property('qrcode_url');",
                  "  pm.expect(jsonData).to.not.have.property('bank_simulator_url');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{cardIdempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"{{cardMerchantPaymentId}}\",\n  \"booking_ref\": \"TK-260101-ABCDE\",\n  \"amount\": 1500,\n  \"currency\": \"THB\",\n  \"method\": \"card\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"return_url\": \"{{concertUrl}}/booking/TK-260101-ABCDE\",\n  \"expires_in\": 600\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments"
              ]
            }
          }
        },
        {
          "name": "Create PromptPay Payment",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var attemptId = 'PP_' + pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('bodyOnlyMerchantPaymentId', attemptId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) pm.collectionVariables.set('bodyOnlyPaymockId', jsonData.id);",
                  "if (jsonData.id) {",
                  "  pm.collectionVariables.set('promptPayId', jsonData.id);",
                  "  pm.collectionVariables.set('paymockId', jsonData.id);",
                  "}",
                  "pm.test('status 201 PENDING', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(jsonData.status).to.eql('PENDING');",
                  "});",
                  "pm.test('payment_id is not null', function () {",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "  pm.expect(jsonData.payment_id).to.eql(pm.collectionVariables.get('bodyOnlyMerchantPaymentId'));",
                  "});",
                  "pm.test('PromptPay URLs present', function () {",
                  "  pm.expect(jsonData.qrcode_url).to.be.a('string').and.include('/qr.svg');",
                  "  pm.expect(jsonData.bank_simulator_url).to.be.a('string');",
                  "  pm.expect(jsonData).to.not.have.property('checkout_url');",
                  "});",
                  "pm.test('booking_ref echoed from request', function () {",
                  "  pm.expect(pm.response.json().booking_ref).to.eql('TK-POSTMAN-PP-BODY');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"{{bodyOnlyMerchantPaymentId}}\",\n  \"booking_ref\": \"TK-POSTMAN-PP-BODY\",\n  \"amount\": 2200,\n  \"currency\": \"THB\",\n  \"method\": \"promptpay\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"expires_in\": 600\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments"
              ]
            },
            "description": "Request body sends booking_ref; response.booking_ref should match it."
          }
        },
        {
          "name": "Body-only Idempotency Retry (payment_id fallback)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('same PayMock id for same body payment_id', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('bodyOnlyPaymockId'));",
                  "  pm.expect(jsonData.payment_id).to.eql(pm.collectionVariables.get('bodyOnlyMerchantPaymentId'));",
                  "});",
                  "pm.test('booking_ref echoed from request', function () {",
                  "  pm.expect(pm.response.json().booking_ref).to.eql('TK-POSTMAN-PP-BODY');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"{{bodyOnlyMerchantPaymentId}}\",\n  \"booking_ref\": \"TK-POSTMAN-PP-BODY\",\n  \"amount\": 2200,\n  \"currency\": \"THB\",\n  \"method\": \"promptpay\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"expires_in\": 600\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments"
              ]
            },
            "description": "Reuses the same body payment_id without an Idempotency-Key header; the controller falls back to payment_id as the key. Request body sends booking_ref; response.booking_ref should match it."
          }
        },
        {
          "name": "Header Idempotency Retry (Idempotency-Key header)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('same gateway id as first create', function () {",
                  "  pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('cardPaymentId'));",
                  "});",
                  "pm.test('payment_id still present', function () {",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "});",
                  "pm.test('Card response has no PromptPay URLs', function () {",
                  "  pm.expect(jsonData).to.have.property('checkout_url');",
                  "  pm.expect(jsonData).to.not.have.property('qrcode_url');",
                  "  pm.expect(jsonData).to.not.have.property('bank_simulator_url');",
                  "  pm.expect(jsonData.return_url).to.be.a('string').and.include('/booking/TK-260101-ABCDE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{cardIdempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"{{cardMerchantPaymentId}}\",\n  \"booking_ref\": \"TK-260101-ABCDE\",\n  \"amount\": 1500,\n  \"currency\": \"THB\",\n  \"method\": \"card\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"return_url\": \"{{concertUrl}}/booking/TK-260101-ABCDE\",\n  \"expires_in\": 600\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments"
              ]
            },
            "description": "Repeat the exact original body with the same Idempotency-Key header; the API uses this header value as the idempotency key."
          }
        },
        {
          "name": "Get Payment Status (Polling / Reconcile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('payment_id is not null', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "  pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('paymockId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/payments/{{paymockId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments",
                "{{paymockId}}"
              ]
            },
            "description": "ใช้ id ใน path"
          }
        },
        {
          "name": "Cancel Payment (Before Paid)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/v1/payments/{{paymockId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments",
                "{{paymockId}}",
                "cancel"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Hosted Card Checkout Redirect",
      "description": "สร้าง Card payment ให้เป็น PENDING ก่อนด้วย POST /v1/payments แล้วเปิด checkout_url ในเบราว์เซอร์ ผู้ใช้กรอกบัตรบน Hosted Checkout และ form จะ POST /payments/{id} เพื่อชำระ payment เดิม ก่อน redirect กลับไปยัง return_url โดยไม่มี payment ID ใน URL",
      "item": [
        {
          "name": "Step 1 – Create Card Payment (PENDING + checkout_url)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set('hostedCardId', jsonData.id); }",
                  "pm.test('PENDING and hosted checkout URL returned', function () {",
                  "  pm.expect(jsonData.status).to.eql('PENDING');",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "  pm.expect(jsonData.checkout_url).to.include('/checkout/');",
                  "  pm.expect(jsonData).to.not.have.property('qrcode_url');",
                  "  pm.expect(jsonData).to.not.have.property('bank_simulator_url');",
                  "  pm.expect(jsonData.return_url).to.be.a('string').and.include('/booking/TK-260101-ABCDE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"CARD_{{$guid}}\",\n  \"booking_ref\": \"TK-260101-ABCDE\",\n  \"amount\": 1500,\n  \"currency\": \"THB\",\n  \"method\": \"card\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"return_url\": \"{{concertUrl}}/booking/TK-260101-ABCDE\",\n  \"expires_in\": 600\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments"
              ]
            },
            "description": "คัดลอก checkout_url ไปเปิดใน browser หรือรัน request ถัดไปเพื่อจำลองการ submit form จาก hosted checkout"
          }
        },
        {
          "name": "Step 1.5 ? GET checkout page and extract CSRF token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var html = pm.response.text();",
                  "var csrfToken = null;",
                  "var inputs = html.match(/<input\\b[^>]*>/gi) || [];",
                  "inputs.some(function (input) {",
                  "  var nameMatch = input.match(/\\bname=['\"]_token['\"]/i);",
                  "  var valueMatch = input.match(/\\bvalue=['\"]([^'\"]+)['\"]/i);",
                  "  if (nameMatch && valueMatch) { csrfToken = valueMatch[1]; return true; }",
                  "  return false;",
                  "});",
                  "pm.test('Checkout page returns successfully', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('CSRF token found in checkout form', function () {",
                  "  pm.expect(csrfToken, 'checkout form _token').to.be.a('string').and.not.empty;",
                  "});",
                  "if (csrfToken) pm.collectionVariables.set('csrfToken', csrfToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/checkout/{{hostedCardId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout",
                "{{hostedCardId}}"
              ]
            },
            "description": "Run after Step 1 and before Step 2. GET the checkout HTML to establish the session cookie and save the hidden _token field as {{csrfToken}}."
          }
        },
        {
          "name": "Step 2 – Submit card to POST /payments/{id}",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Redirects to the merchant return URL', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([302, 303]);",
                  "  pm.expect(pm.response.headers.get('Location')).to.include('/booking/TK-260101-ABCDE');",
                  "  pm.expect(pm.response.headers.get('Location')).to.not.include('payment_id=');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "_token",
                  "value": "{{csrfToken}}"
                },
                {
                  "key": "card_number",
                  "value": "4242 4242 4242 4242"
                },
                {
                  "key": "expiry",
                  "value": "12/28"
                },
                {
                  "key": "cvc",
                  "value": "123"
                },
                {
                  "key": "cardholder",
                  "value": "SUCCESS USER"
                },
                {
                  "key": "redirect_to_return",
                  "value": "1"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/payments/{{hostedCardId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{hostedCardId}}"
              ]
            },
            "description": "route ของ Hosted Checkout ที่ใช้ settle payment เดิม; ส่ง form fields จากหน้า checkout เท่านั้น ไม่ส่ง API key"
          },
          "description": "Submit the checkout form using the session cookie from Step 1.5 and the extracted CSRF token."
        }
      ]
    },
    {
      "name": "3. PromptPay – All Cases",
      "description": "สร้างด้วย POST /v1/payments โดยส่ง body.payment_id (method=promptpay); response มี qrcode_url และ bank_simulator_url แต่ไม่มี checkout_url. เส้นทาง simulate, bank-simulate, GET และ cancel ใช้ id ใน path.",
      "item": [
        {
          "name": "PromptPay: Create (PENDING + QR URLs)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "  pm.collectionVariables.set('promptPayId', jsonData.id);",
                  "  pm.collectionVariables.set('paymockId', jsonData.id);",
                  "}",
                  "pm.test('PENDING PromptPay has payment_id', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(jsonData.status).to.eql('PENDING');",
                  "  pm.expect(jsonData.payment_id).to.not.equal(null);",
                  "  pm.expect(jsonData.paid_at).to.equal(null);",
                  "  pm.expect(jsonData.qrcode_url).to.include('/qr.svg');",
                  "  pm.expect(jsonData.bank_simulator_url).to.be.a('string');",
                  "  pm.expect(jsonData).to.not.have.property('checkout_url');",
                  "});",
                  "pm.test('booking_ref echoed from request', function () {",
                  "  pm.expect(pm.response.json().booking_ref).to.eql('TK-POSTMAN-PP-MAIN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"PP_{{$guid}}\",\n  \"booking_ref\": \"TK-POSTMAN-PP-MAIN\",\n  \"amount\": 2200,\n  \"currency\": \"THB\",\n  \"method\": \"promptpay\",\n  \"callback_url\": \"http://concert_backend:5000/api/webhook\",\n  \"expires_in\": 600\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments"
              ]
            },
            "description": "คาดหวัง: status=PENDING, payment_id ไม่เป็น null, paid_at=null, qrcode_url, bank_simulator_url Request body sends booking_ref; response.booking_ref should match it."
          }
        },
        {
          "name": "PromptPay: GET QR SVG (no auth)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/payments/{{promptPayId}}/qr.svg",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payments",
                "{{promptPayId}}",
                "qr.svg"
              ]
            }
          }
        },
        {
          "name": "PromptPay: Simulate COMPLETED (POST /checkout/.../simulate)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout/{{promptPayId}}/simulate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout",
                "{{promptPayId}}",
                "simulate"
              ]
            },
            "description": "รันหลัง Create โดยใช้ payment id ใน path | ตั้ง paid_at=now(), ยิง webhook payment.completed"
          }
        },
        {
