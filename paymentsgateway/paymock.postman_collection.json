    {
      "name": "5. Concert Backend — Hosted Card Redirect + PromptPay",
      "description": "create-booking สร้าง booking + Concert payment แรก. เมื่อ method=card ระบบคืน checkout_url เพื่อเปิด Hosted Checkout (/checkout/{id}) และหลังจ่าย Gateway กลับ /booking/{booking_ref} โดยไม่มี payment ID ใน URL; หน้าจองอ่านสถานะจาก DB ใหม่. Concert demo API ใช้ query/body.payment_id. หาก FAILED/EXPIRED ให้สร้าง Concert payment ใหม่ใน booking เดิมด้วย POST /api/bookings/{bookingId}/payments.",
      "item": [
        {
          "name": "POST create-booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "pm.test('booking and payment created', function () { pm.expect(j.ok).to.eql(true); pm.expect(j.booking_id).to.be.a('number'); });",
                  "if (j.ok) { pm.collectionVariables.set('bookingId', String(j.booking_id)); pm.collectionVariables.set('concertPaymentId', j.payment_id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seat\": \"VIP-A1\",\n  \"amount\": 3500.00,\n  \"method\": \"card\"\n}"
            },
            "url": {
              "raw": "{{concertUrl}}/api/create-booking",
              "host": [
                "{{concertUrl}}"
              ],
              "path": [
                "api",
                "create-booking"
              ]
            }
          }
        },
        {
          "name": "POST /api/bookings/{bookingId}/payments — Payment ใหม่ใน Booking เดิม",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "pm.test('same booking, new Concert payment', function () { pm.expect(j.ok).to.eql(true); pm.expect(String(j.booking_id)).to.eql(pm.collectionVariables.get('bookingId')); pm.expect(j.concert_payment_id).to.be.a('number'); });",
                  "if (j.ok) pm.collectionVariables.set('concertPaymentId', j.payment_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"card\"\n}"
            },
            "url": {
              "raw": "{{concertUrl}}/api/bookings/{{bookingId}}/payments",
              "host": [
                "{{concertUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "{{bookingId}}",
                "payments"
              ]
            }
          }
        },
        {
          "name": "GET booking-status ?payment_id=",
          "request": {
