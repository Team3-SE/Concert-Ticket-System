# ==========================================
# Git Ignore Configuration
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example

# Composer & PHP dependencies
/vendor/
/paymock/vendor/

# Node dependencies
/node_modules/
npm-debug.log
yarn-error.log

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# SQLite Databases & temporary database files
*.sqlite
*.sqlite-journal
*.sqlite-wal
/paymock/database/*.sqlite
/paymock/database/*.sqlite-journal
/paymock/database/*.sqlite-wal

# Laravel storage logs & cache
/paymock/storage/*.key
/paymock/storage/logs/*.log
/paymock/storage/framework/cache/*
!/paymock/storage/framework/cache/.gitkeep
/paymock/storage/framework/sessions/*
!/paymock/storage/framework/sessions/.gitkeep
/paymock/storage/framework/views/*
!/paymock/storage/framework/views/.gitkeep

# SonarQube Scanner work directories & cache
.scannerwork/
.sonar/
/paymock/.scannerwork/
/paymock/.sonar/

# OWASP ZAP temporary reports & scan output
report_html.html
report_json.json
report_md.md
zap_scan/
zap-report.html
zap-report.json
zap-report.md
.zap/wrk/

# Test coverage & reports
coverage/
coverage.xml
test-report.xml
.phpunit.result.cache

# IDE & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
