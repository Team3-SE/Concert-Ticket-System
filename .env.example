# ============================================================
# Concert Ticket System — Environment Variables
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_NAME="Concert Ticket System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# ─── Timezone / Locale ───────────────────────────────────────
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=th
APP_FALLBACK_LOCALE=en

# ─── Database (MySQL) ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=concert_db
DB_USERNAME=concert_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

# ─── Cache / Session / Queue ─────────────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ─── NGINX Port (host machine port) ──────────────────────────
NGINX_PORT=8080

# ─── Mail (for notifications) ────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@concert.local"
MAIL_FROM_NAME="${APP_NAME}"

# ส่งอีเมลจริงผ่าน Gmail: เปิด 2-Step Verification แล้วสร้าง App Password (16 ตัว)
# ที่ https://myaccount.google.com/apppasswords จากนั้นแทนค่า 6 บรรทัดด้านบนด้วยชุดนี้ใน .env ของเครื่องตัวเอง (ห้าม commit)
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-account@gmail.com
#   MAIL_PASSWORD=app-password-16-chars
#   MAIL_ENCRYPTION=tls
#   MAIL_FROM_ADDRESS=your-account@gmail.com
# หมายเหตุ: ลิงก์ยืนยันสร้างจาก APP_URL ถ้าให้เครื่องอื่นกดต้องตั้ง APP_URL เป็น IP/โดเมนที่เข้าถึงได้

# ─── Cloudflare (production only) ────────────────────────────
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# ─── Seat Lock TTL (seconds) ──────────────────────────────────
SEAT_LOCK_TTL=600
