---
config:
  theme: base
  look: classic
  layout: elk
  htmlLabels: false
  themeCSS: ".edgeLabel .background { fill: #d3d3d3 !important; opacity: 1 !important; } .relation { stroke-width: 1.35px; }"
  themeVariables:
    fontFamily: "Angsana New"
    fontSize: "20px"
    primaryColor: "#ffffff"
    primaryTextColor: "#28253d"
    primaryBorderColor: "#26263d"
    lineColor: "#333333"
    secondaryColor: "#ffffff"
    tertiaryColor: "#ffffff"
    edgeLabelBackground: "#d3d3d3"
  class:
    useMaxWidth: false
    padding: 16
    nodeSpacing: 100
    rankSpacing: 100
  flowchart:
    wrappingWidth: 1000
  elk:
    mergeEdges: false
    nodePlacementStrategy: NETWORK_SIMPLEX
---
classDiagram
direction LR
class company {
    -String company_id
    -String name
    -String initials
    -String description
    -Date created_at
    +String getCompanyInfo()
    +List~concert~ listEvents()
}
class appUser {
    <<abstract>>
    #String user_id
    #String password_hash
    #Role role
    #AccountStatus account_status
    #Date created_at
    +Boolean login()
    +void logout()
}
class customer {
    -String customer_id
    -String email
    -String phone
    -String first_name
    -String last_name
    +void register()
    +List~concert~ searchConcert(keyword)
    +booking createBooking(concert, seats, standingItems)
    +List~booking~ viewHistory()
    +List~ticket~ viewTickets()
}
class eventOrganizer {
    -String organizer_id
    -String company_id
    -String email
    -String username
    +concert createConcert(details)
    +void defineSeatMap(concert, mapDetails)
    +report viewSalesRealTime(concert)
}
class staff {
    -String staff_id
    -String company_id
    -String created_by_organizer_id
    -String username
    +Boolean scanTicketQR(qrCode)
}
class admin {
    -String admin_id
    -String email
    -String username
    +void manageUser(userID, action)
    +List~systemAnomaly~ viewAnomalies(filters)
    +void acknowledgeAnomaly(anomalyID)
    +void resolveAnomaly(anomalyID, reason, files)
}
%% =========================================================
%% CONCERT / SEAT MAP
%% =========================================================
class concert {
    -String concert_id
    -String company_id
    -String organizer_id
    -String name
    -String artist
    -String venue
    -Date event_datetime
    -String description
    -String poster_path
    -String seat_map_image_path
    -Date sale_start_datetime
    -Date sale_end_datetime
    -Integer max_ticket_per_order
    -ConcertStatus status
    -String concert_code
    +ConcertInfo getDetails()
}
class concertContact {
    -String contact_id
    -String concert_id
    -ContactType contact_type
    -String value
}
class zone {
    -String zone_id
    -String concert_id
    -String name
    -ZoneType zone_type
    -Double price
    -Integer capacity
    -String color
    +List~seat~ getAvailableSeats()
    +Integer getAvailableCapacity()
}
class zoneSeatPattern {
    -String pattern_id
    -String zone_id
    -String pattern_type
    -Integer start_row
    -Integer start_seat_number
    -Integer row_count
    -Integer seats_per_row
    +List~seat~ generateSeats()
}
class seat {
    -String seat_id
    -String zone_id
    -String row
    -Integer number
    -SeatStatus status
    +void lockSeat()
    +void unlockSeat()
    +void confirmSeat()
}
%% =========================================================
%% BOOKING
%% =========================================================
class booking {
    -String booking_id
    -String customer_id
    -String concert_id
    -Date booking_date
    -Double total_amount
    -BookingStatus status
    -Date expiry_time
    -String booking_code
    +Double calculateTotal()
    +void confirmBooking()
    +void cancelBooking()
    +Boolean checkExpiry()
}
class bookingSeat {
    -String booking_id
    -String seat_id
    -String zone_name_snapshot
    -String seat_label_snapshot
    -Double unit_price_snapshot
}
class bookingStandingItem {
    -String booking_id
    -String zone_id
    -Integer quantity
    -String zone_name_snapshot
    -Double unit_price_snapshot
}
%% =========================================================
%% PAYMENT / ORDER / TICKET
%% =========================================================
class payment {
    -String payment_id
    -String booking_id
    -Double amount
    -PaymentMethod method
    -PaymentStatus status
    -Date payment_date
    -String provider_transaction_id
    -String decline_code
    -RiskLevel risk_level
    -String card_fingerprint
    +Boolean processPayment()
    +Boolean verifyStatus()
}
class chargeback {
    -String chargeback_id
    -String payment_id
    -String provider_chargeback_id
    -String reason
    -Double amount
    -Date created_at
    -Date resolved_at
}
class customerOrder {
    -String order_id
    -String booking_id
    -String payment_id
    -Date order_date
    -String order_code
    -String concert_name_snapshot
    -String artist_snapshot
    -String venue_snapshot
    -Date event_datetime_snapshot
    +List~ticket~ generateTickets()
}
class ticket {
    -String ticket_id
    -String order_id
    -String concert_id
    -String zone_id
    -String seat_id
    -String qr_code
    -Boolean is_used
    -String ticket_code
    -String zone_name_snapshot
    -String seat_label_snapshot
    -Double unit_price_snapshot
    +String generateQR()
    +Boolean validateTicket()
    +void markAsUsed()
}
class seatLockLog {
    -String lock_id
    -String booking_id
    -String seat_id
    -Date locked_at
    -Date expired_at
    -Date released_at
    -SeatLockStatus status
}
class staffConcert {
    -String staff_id
    -String concert_id
}
class ticketValidationLog {
    -String validation_id
    -String ticket_id
    -String staff_id
    -Date validation_time
    -String result
}
class systemAnomaly {
    -String anomaly_id
    -String booking_id
    -String reviewed_by_admin_id
    -AnomalyType type
    -String message
    -Date timestamp
    -AnomalyStatus status
    -String resolve_reason
    -String anomaly_code
    +void updateStatus(newStatus)
    +void addAttachment(file)
}
class anomalyAttachment {
    -String attachment_id
    -String anomaly_id
    -String file_path
}
class auditLog {
    -String log_id
    -String user_id
    -String action
    -Date timestamp
    -String ip_address
    +String getDetails()
}
class report {
    -String report_id
    -String concert_id
    -Double total_sales
    -Date generated_at
}
class Role {
    <<enumeration>>
    CUSTOMER
    ORGANIZER
    STAFF
    ADMIN
}
class AccountStatus {
    <<enumeration>>
    ACTIVE
    SUSPENDED
}
class ConcertStatus {
    <<enumeration>>
    DRAFT
    SCHEDULED
    ON_SALE
    SALE_CLOSED
    SALE_SUSPENDED
    COMPLETED
}
class ContactType {
    <<enumeration>>
    PHONE
    LINE
    FACEBOOK
    EMAIL
}
class ZoneType {
    <<enumeration>>
    SEATED
    STANDING
}
class SeatStatus {
    <<enumeration>>
    AVAILABLE
    LOCKED
    BOOKED
}
class BookingStatus {
    <<enumeration>>
    PENDING_PAYMENT
    CONFIRMED
    CANCELLED
    EXPIRED
}
class PaymentMethod {
    <<enumeration>>
    PROMPTPAY
    CREDIT_CARD
}
class PaymentStatus {
    <<enumeration>>
    PENDING
    COMPLETED
    FAILED
    EXPIRED
}
class RiskLevel {
    <<enumeration>>
    LOW
    MEDIUM
    HIGH
}
class SeatLockStatus {
    <<enumeration>>
    LOCKED
    EXPIRED
    RELEASED
    CONVERTED_TO_BOOKING
}
class AnomalyStatus {
    <<enumeration>>
    UNRESOLVED
    INVESTIGATING
    RESOLVED
}
class AnomalyType {
    <<enumeration>>
    PAYMENT_FRAUD_CARD_TESTING
    SEAT_HOARDING_ABUSE
    CHARGEBACK_ABUSE
}
appUser <|-- customer
appUser <|-- eventOrganizer
appUser <|-- staff
appUser <|-- admin
company "1" --> "0..*" eventOrganizer : has
company "1" --> "0..*" staff : has
company "1" --> "0..*" concert : organizes
eventOrganizer "1" --> "0..*" staff : creates
eventOrganizer "1" --> "0..*" concert : manages
concert "1" --> "0..*" concertContact : has
concert "1" --> "0..*" zone : contains
zone "1" --> "0..1" zoneSeatPattern : pattern
zone "1" --> "0..*" seat : contains
customer "1" --> "0..*" booking : creates
concert "1" --> "0..*" booking : receives
booking "1" --> "0..*" bookingSeat : has
seat "1" --> "0..*" bookingSeat : referencedBy
booking "1" --> "0..*" bookingStandingItem : has
zone "1" --> "0..*" bookingStandingItem : referencedBy
booking "1" --> "0..1" payment : payment
booking "1" --> "0..1" customerOrder : creates
payment "1" --> "0..1" customerOrder : creates
payment "1" --> "0..*" chargeback : has
customerOrder "1" --> "1..*" ticket : generates
concert "1" --> "0..*" ticket : has
zone "1" --> "0..*" ticket : has
seat "1" --> "0..1" ticket : assignedTo
booking "1" --> "0..*" seatLockLog : has
seat "1" --> "0..*" seatLockLog : lockHistory
staff "1" --> "0..*" staffConcert : assigned
concert "1" --> "0..*" staffConcert : assigned
staff "1" --> "0..*" ticketValidationLog : validates
ticket "1" --> "0..*" ticketValidationLog : validationHistory
booking "1" --> "0..*" systemAnomaly : has
admin "1" --> "0..*" systemAnomaly : reviews
systemAnomaly "1" --> "0..*" anomalyAttachment : attachments
appUser "1" --> "0..*" auditLog : creates
concert "1" --> "0..*" report : reports
%% =========================================================
%% ENUM USAGE
%% =========================================================
appUser --> Role
appUser --> AccountStatus
concert --> ConcertStatus
concertContact --> ContactType
zone --> ZoneType
seat --> SeatStatus
booking --> BookingStatus
payment --> PaymentMethod
payment --> PaymentStatus
payment --> RiskLevel
seatLockLog --> SeatLockStatus
systemAnomaly --> AnomalyStatus
systemAnomaly --> AnomalyType